# Copy to .env for local development. Never commit the real .env file.
API_KEY=dev-local-api-key
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_response
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
ENVIRONMENT=development
TRIAGE_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY is not required here — the Anthropic SDK resolves credentials
# itself (this env var, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile).
# Set one of these locally before calling /internal/incidents/{id}/triage.
# ANTHROPIC_API_KEY=sk-ant-...
